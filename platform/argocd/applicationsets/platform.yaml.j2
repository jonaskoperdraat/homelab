#jinja2: variable_start_string: "[[", variable_end_string: "]]", block_start_string: "[%", block_end_string: "%]"
# Rendered by ../../bootstrap.yml with the settings from environments/<env>.yml
apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: platform
  namespace: argocd
spec:
  generators:
    - git:
        repoURL: &repoURL https://github.com/jonaskoperdraat/homelab
        revision: &revision [[ revision ]]
        directories:
          - path: platform/apps/*
[% for app in excluded_apps if app.startswith('platform/') %]
          - path: [[ app ]]
            exclude: true
[% endfor %]
  template:
    metadata:
      name: '{{path.basename}}'
      labels:
        layer: platform
    spec:
      destination:
        name: in-cluster
        namespace: '{{path.basename}}'
      project: default  # TODO
      source:
        repoURL: *repoURL
        path: '{{path}}'
        targetRevision: *revision
        plugin:
          name: helm-env
          env:
            - name: ENVIRONMENT
              value: [[ env ]]
            - name: DOMAIN
              value: [[ domain ]]
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        retry:
          limit: 10
          backoff:
            duration: 1m
            factor: 2
            maxDuration: 16m
        syncOptions:
          - CreateNamespace=true
          - ApplyOutOfSyncOnly=true
          - ServerSideApply=true
          # On a new cluster, CRDs such as ServiceMonitor appear when another
          # app syncs; don't let them block the rest of this app
          - SkipDryRunOnMissingResource=true
        managedNamespaceMetadata:
          annotations:
            # Enable privileged VolSync movers by default for all namespaces
            # TODO this may be refactored in the future for finer granularity
            # See also https://volsync.readthedocs.io/en/stable/usage/permissionmodel.html
            volsync.backube/privileged-movers: "true"
